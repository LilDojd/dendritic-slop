{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": true,
  "platformAutomerge": false,
  "timezone": "Etc/UTC",
  "schedule": ["before 6am on Monday"],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 6am on Monday"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update pinned Pi npm packages",
      "managerFilePatterns": ["/\\.nix$/"],
      "matchStrings": [
        "# renovate: datasource=npm depName=(?<depName>\\S+)\\s+(?:source\\s*=\\s*)?\"npm:.*@(?<currentValue>[^\"\\s]+)\""
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group ordinary Nix flake input updates",
      "matchManagers": ["nix"],
      "matchDepNames": [
        "!actionbook-rust-skills",
        "!astral-agent-skills",
        "!claude-plugins-official",
        "!herdr-plugin-jj-workspace",
        "!herdr-projects",
        "!joelhooks-skills",
        "!leonardomso-rust-skills",
        "!narumitw-pi-extensions"
      ],
      "groupName": "Nix flake inputs"
    },
    {
      "description": "Review Actionbook Rust skills separately",
      "matchManagers": ["nix"],
      "matchDepNames": ["actionbook-rust-skills"],
      "groupName": "Actionbook Rust skills",
      "minimumReleaseAge": "3 days",
      "automerge": false
    },
    {
      "description": "Review Astral agent skills separately",
      "matchManagers": ["nix"],
      "matchDepNames": ["astral-agent-skills"],
      "groupName": "Astral agent skills",
      "minimumReleaseAge": "3 days",
      "automerge": false
    },
    {
      "description": "Review Anthropic Claude plugin skills separately",
      "matchManagers": ["nix"],
      "matchDepNames": ["claude-plugins-official"],
      "groupName": "Anthropic Claude plugin skills",
      "minimumReleaseAge": "3 days",
      "automerge": false
    },
    {
      "description": "Review Joel Hooks skills separately",
      "matchManagers": ["nix"],
      "matchDepNames": ["joelhooks-skills"],
      "groupName": "Joel Hooks skills",
      "minimumReleaseAge": "3 days",
      "automerge": false
    },
    {
      "description": "Review Leonardo Rust skills separately",
      "matchManagers": ["nix"],
      "matchDepNames": ["leonardomso-rust-skills"],
      "groupName": "Leonardo Rust skills",
      "minimumReleaseAge": "3 days",
      "automerge": false
    },
    {
      "description": "Review Narumitw Pi extensions separately",
      "matchManagers": ["nix"],
      "matchDepNames": ["narumitw-pi-extensions"],
      "groupName": "Narumitw Pi extensions",
      "minimumReleaseAge": "3 days",
      "automerge": false
    },
    {
      "description": "Separate Herdr plugin input updates",
      "matchManagers": ["nix"],
      "matchDepNames": ["herdr-plugin-jj-workspace", "herdr-projects"],
      "groupName": "Herdr plugins",
      "minimumReleaseAge": "3 days",
      "automerge": false
    },
    {
      "description": "Group pinned Pi npm package updates",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["npm"],
      "groupName": "Pi npm packages",
      "minimumReleaseAge": "3 days",
      "rangeStrategy": "pin",
      "automerge": false
    }
  ]
}
